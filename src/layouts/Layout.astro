---
const {
	title = '京大生限定長期インターンシップ | 株式会社晃商HD',
	description = '株式会社晃商HDが実施する、京大生限定の長期インターンシップ募集ページです。',
	page = '',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header" aria-label="サイトヘッダー">
			<a class="brand" href="/" aria-label="KOSHO Holdings">
				<img src="https://www.k-kosho.co.jp/common/img/logo_main.png" alt="KOSHO 株式会社晃商" />
			</a>
			<nav class="nav" aria-label="サイトナビゲーション">
				<a class={page === 'requirements' ? 'active' : ''} href="/">募集要項</a>
				<a class={page === 'departments' ? 'active' : ''} href="/departments/">部署紹介</a>
				<a class={page === 'contact' ? 'active' : ''} href="/contact/">お問い合わせ</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="footer">
			<p>KOSHO Holdings Co., Ltd.</p>
			<small>Kyoto University Internship LP</small>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background: #061a3d;
		color: #f6f9ff;
		font-family:
			"Yu Gothic", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo,
			sans-serif;
		line-height: 1.8;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.site-header {
		align-items: center;
		background: rgba(6, 26, 61, 0.94);
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
		display: flex;
		justify-content: space-between;
		left: 0;
		min-height: 76px;
		padding: 18px clamp(20px, 5vw, 72px);
		position: fixed;
		right: 0;
		top: 0;
		z-index: 10;
	}

	.brand {
		align-items: center;
		background: #ffffff;
		display: inline-flex;
		padding: 8px 12px;
	}

	.brand img {
		display: block;
		height: 38px;
		width: auto;
	}

	.nav {
		display: flex;
		gap: clamp(14px, 3vw, 38px);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.nav a {
		border-bottom: 1px solid transparent;
		padding-bottom: 4px;
	}

	.nav a:hover,
	.nav a.active {
		border-color: #ffffff;
	}

	:global(.page-hero) {
		background:
			linear-gradient(120deg, rgba(6, 26, 61, 0.98), rgba(0, 82, 169, 0.78)),
			linear-gradient(180deg, #061a3d, #004f9f);
		display: grid;
		gap: clamp(32px, 6vw, 72px);
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
		min-height: 76vh;
		padding: 138px clamp(20px, 5vw, 72px) 72px;
	}

	:global(.page-hero.visual) {
		background:
			linear-gradient(90deg, rgba(6, 26, 61, 0.94), rgba(0, 62, 142, 0.54)),
			var(--hero-image) center / cover;
	}

	:global(.hero-copy) {
		align-self: center;
		max-width: 880px;
	}

	:global(.eyebrow),
	:global(.section-kicker) {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	:global(.page-title) {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.5rem, 9vw, 8.6rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 0.98;
		margin: 28px 0;
	}

	:global(.lead) {
		font-size: clamp(1rem, 1.5vw, 1.18rem);
		max-width: 720px;
	}

	:global(.hero-panel) {
		align-self: end;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.24);
		padding: clamp(22px, 4vw, 36px);
	}

	:global(.hero-logo) {
		background: #ffffff;
		display: inline-flex;
		margin-bottom: 24px;
		padding: 14px 18px;
	}

	:global(.hero-logo img) {
		display: block;
		max-width: min(320px, 72vw);
		width: 100%;
	}

	:global(.visual-panel) {
		align-self: end;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: 0 22px 42px rgba(0, 0, 0, 0.24);
		color: #061a3d;
		padding: clamp(22px, 4vw, 34px);
	}

	:global(.visual-panel h2) {
		color: #003b82;
		font-size: clamp(1.4rem, 3vw, 2.4rem);
		line-height: 1.35;
		margin: 0 0 14px;
	}

	:global(.section) {
		padding: clamp(72px, 10vw, 132px) clamp(20px, 5vw, 72px);
	}

	:global(.section.blue) {
		background: #003b82;
	}

	:global(.section.deep) {
		background: #06295f;
	}

	:global(.section.light) {
		background: #f1f6ff;
		color: #061a3d;
	}

	:global(.section-heading) {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.2rem, 5vw, 5rem);
		font-weight: 400;
		letter-spacing: 0;
		line-height: 1.18;
		margin: 14px 0 34px;
	}

	:global(.split) {
		display: grid;
		gap: clamp(28px, 6vw, 80px);
		grid-template-columns: minmax(240px, 0.85fr) minmax(280px, 1.15fr);
	}

	:global(.card-grid) {
		display: grid;
		gap: 1px;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 42px;
	}

	:global(.card-grid.two) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	:global(.card-grid.four) {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	:global(.visual-grid) {
		display: grid;
		gap: 22px;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 42px;
	}

	:global(.visual-card) {
		background: #ffffff;
		border-radius: 18px;
		box-shadow: 0 18px 28px rgba(6, 26, 61, 0.16);
		color: #061a3d;
		overflow: hidden;
	}

	:global(.visual-card img) {
		aspect-ratio: 16 / 10;
		display: block;
		object-fit: cover;
		width: 100%;
	}

	:global(.visual-card div) {
		padding: 22px;
	}

	:global(.visual-card h3) {
		color: #003b82;
		font-size: 1.25rem;
		margin: 0 0 8px;
	}

	:global(.card) {
		background: #f8fbff;
		border-top: 4px solid #7ab8ff;
		color: #061a3d;
		min-width: 0;
		padding: clamp(20px, 3vw, 32px);
	}

	:global(.card strong),
	:global(.number) {
		color: #005bb8;
	}

	:global(.card h3) {
		font-size: clamp(1.35rem, 2vw, 1.9rem);
		letter-spacing: 0.08em;
		line-height: 1.45;
		margin: 12px 0 14px;
	}

	:global(.button-row) {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 38px;
	}

	:global(.button) {
		align-items: center;
		border: 1px solid #ffffff;
		display: inline-flex;
		font-size: 0.78rem;
		font-weight: 700;
		justify-content: center;
		letter-spacing: 0.18em;
		min-height: 48px;
		padding: 12px 22px;
		transition:
			background 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}

	:global(.button:hover) {
		transform: translateY(-2px);
	}

	:global(.button.primary) {
		background: #ffffff;
		color: #003b82;
	}

	:global(.button.secondary) {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	:global(.button.dark) {
		background: #003b82;
		border-color: #003b82;
		color: #ffffff;
	}

	:global(.definition-list) {
		border-top: 1px solid rgba(255, 255, 255, 0.42);
		margin: 0;
		max-width: 980px;
	}

	:global(.definition-list div) {
		border-bottom: 1px solid rgba(255, 255, 255, 0.24);
		display: grid;
		gap: 24px;
		grid-template-columns: 140px 1fr;
		padding: 22px 0;
	}

	:global(.definition-list dt) {
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	:global(.definition-list dd) {
		margin: 0;
	}

	:global(.info-list) {
		border-top: 1px solid rgba(6, 26, 61, 0.2);
		margin: 0;
	}

	:global(.info-list div) {
		border-bottom: 1px solid rgba(6, 26, 61, 0.16);
		display: grid;
		gap: 20px;
		grid-template-columns: 130px 1fr;
		padding: 18px 0;
	}

	:global(.info-list dt) {
		color: #003b82;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	:global(.section.blue .info-list) {
		border-top-color: rgba(255, 255, 255, 0.42);
	}

	:global(.section.blue .info-list div) {
		border-bottom-color: rgba(255, 255, 255, 0.24);
	}

	:global(.section.blue .info-list dt) {
		color: #7ab8ff;
	}

	:global(.info-list dd) {
		margin: 0;
	}

	:global(.note-box) {
		background: rgba(255, 255, 255, 0.1);
		border-left: 4px solid #7ab8ff;
		margin-top: 36px;
		max-width: 980px;
		padding: 24px;
	}

	:global(.section.light .note-box) {
		background: rgba(0, 59, 130, 0.08);
	}

	:global(.profile-box) {
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.22);
		padding: clamp(24px, 4vw, 38px);
	}

	:global(.voice-card) {
		align-items: center;
		background: #ffffff;
		border-radius: 18px;
		color: #061a3d;
		display: grid;
		gap: 28px;
		grid-template-columns: 180px 1fr;
		margin-top: 34px;
		max-width: 980px;
		padding: clamp(24px, 4vw, 38px);
	}

	:global(.voice-photo) {
		align-items: center;
		aspect-ratio: 1;
		background:
			linear-gradient(135deg, rgba(0, 91, 184, 0.18), rgba(6, 26, 61, 0.04)),
			#d8e8fb;
		border-radius: 50%;
		display: flex;
		justify-content: center;
		overflow: hidden;
	}

	:global(.voice-photo img) {
		height: 100%;
		object-fit: cover;
		width: 100%;
	}

	:global(.voice-photo.placeholder) {
		color: #003b82;
		font-size: 3rem;
		font-weight: 700;
	}

	:global(.voice-card h3) {
		color: #003b82;
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		line-height: 1.2;
		margin: 6px 0 8px;
	}

	:global(.voice-card p:last-child) {
		margin-bottom: 0;
	}

	:global(.skill-pills) {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	:global(.skill-pills span) {
		background: #ffffff;
		border-radius: 999px;
		box-shadow: 0 10px 20px rgba(6, 26, 61, 0.14);
		color: #003b82;
		font-weight: 700;
		padding: 10px 18px;
	}

	:global(.profile-box h3) {
		font-size: clamp(1.8rem, 4vw, 3.4rem);
		line-height: 1.1;
		margin: 14px 0 18px;
	}

	:global(.timeline) {
		counter-reset: timeline;
		display: grid;
		gap: 1px;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		list-style: none;
		margin: 42px 0 0;
		padding: 0;
	}

	:global(.timeline li) {
		background: #ffffff;
		border-top: 4px solid #003b82;
		counter-increment: timeline;
		min-width: 0;
		padding: clamp(20px, 3vw, 30px);
		position: relative;
	}

	:global(.timeline li::before) {
		color: #005bb8;
		content: counter(timeline, decimal-leading-zero);
		display: block;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 2.4rem;
		line-height: 1;
		margin-bottom: 18px;
	}

	:global(.timeline strong) {
		display: block;
		font-size: 1.08rem;
		letter-spacing: 0.08em;
		line-height: 1.5;
	}

	:global(.timeline p) {
		margin-bottom: 0;
	}

	:global(.contact-form) {
		display: grid;
		gap: 18px;
		max-width: 760px;
	}

	:global(.contact-form label) {
		display: grid;
		font-weight: 700;
		gap: 8px;
		letter-spacing: 0.06em;
	}

	:global(.contact-form input),
	:global(.contact-form textarea),
	:global(.contact-form select) {
		border: 1px solid rgba(6, 26, 61, 0.24);
		font: inherit;
		min-height: 48px;
		padding: 12px 14px;
		width: 100%;
	}

	:global(.contact-form textarea) {
		min-height: 160px;
		resize: vertical;
	}

	.footer {
		align-items: center;
		background: #061a3d;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		display: flex;
		justify-content: space-between;
		gap: 20px;
		padding: 28px clamp(20px, 5vw, 72px);
	}

	.footer p {
		font-family: Georgia, "Times New Roman", serif;
		margin: 0;
	}

	.footer small {
		letter-spacing: 0.08em;
	}

	@media (max-width: 860px) {
		.site-header {
			position: sticky;
		}

		.nav {
			gap: 12px;
			letter-spacing: 0.08em;
		}

		:global(.page-hero),
		:global(.split) {
			grid-template-columns: 1fr;
		}

		:global(.page-hero) {
			padding-top: 56px;
		}

		:global(.card-grid) {
			grid-template-columns: 1fr;
		}

		:global(.card-grid.two),
		:global(.card-grid.four),
		:global(.timeline),
		:global(.visual-grid) {
			grid-template-columns: 1fr;
		}

		:global(.voice-card) {
			grid-template-columns: 1fr;
		}

		:global(.voice-photo) {
			max-width: 180px;
		}
	}

	@media (max-width: 560px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 14px;
			min-height: 0;
		}

		:global(.page-title) {
			font-size: clamp(3.2rem, 18vw, 5.2rem);
		}

		:global(.button) {
			width: 100%;
		}

		:global(.definition-list div) {
			gap: 6px;
			grid-template-columns: 1fr;
		}

		:global(.info-list div) {
			gap: 6px;
			grid-template-columns: 1fr;
		}

		.footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
