---
import Layout from '../layouts/Layout.astro';

const contactFormUrl =
	'https://docs.google.com/forms/d/e/1FAIpQLSdzTKblIKvDJjqMTiRy-0OegSCrUjX2rkEzpJI-4WBPnecGNA/viewform?usp=publish-editor';
---

<Layout
	page="contact"
	title="お問い合わせ | 京大生限定長期インターンシップ | 株式会社晃商HD"
	description="株式会社晃商HD 京大生限定長期インターンシップのお問い合わせページです。"
>
	<section class="page-hero">
		<div class="hero-copy">
			<p class="eyebrow">Contact</p>
			<h1 class="page-title">お問い合わせ</h1>
			<p class="lead">
				応募前の質問、部署ごとの活動内容、参加スケジュールなどについて相談できるページです。
				以下のフォームからお問い合わせ内容を送信してください。
			</p>
			<div class="button-row">
				<a class="button primary" href="/">募集要項を見る</a>
				<a class="button secondary" href="/departments/">インターン内容を見る</a>
				<a class="button secondary" href={contactFormUrl} target="_blank" rel="noreferrer">お問い合わせフォームへ</a>
			</div>
		</div>
		<aside class="hero-panel">
			<p class="section-kicker">For Applicants</p>
			<p>
				応募前に気になることや、仕事内容について確認したいことがあれば、お気軽にお問い合わせください。
			</p>
		</aside>
	</section>

	<section class="section light">
		<p class="section-kicker">Inquiry Form</p>
		<h2 class="section-heading">質問フォーム</h2>
		<p class="lead">
			お問い合わせはGoogle Formで受け付けています。
			応募前の不安や、部署・勤務条件についての質問はこちらから送信してください。
		</p>
		<div class="button-row">
			<a class="button dark" href={contactFormUrl} target="_blank" rel="noreferrer">Google Formを開く</a>
		</div>
	</section>
</Layout>
